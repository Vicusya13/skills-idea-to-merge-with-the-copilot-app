---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// Implemented in Step 3: see the client <script> below.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // TODO (Step 3): implement the bookmarks feature here.
  //   1. On form submit, call event.preventDefault() FIRST so the page
  //      never reloads, then read and validate the original URL.
  //   2. Generate a short slug with a "mona-" prefix (for example, base62
  //      of a counter or hash → "mona-7fk2").
  //   3. Save the original URL and its slug, then persist them in the browser.
  //   4. Render each saved bookmark into #bookmark-list as a row (li.bookmark) with:
  //        - the original URL as a link (.url) that opens in a new tab,
  //        - its short slug shown as a badge (.slug), and
  //        - a "Copy" button (.copy) that copies the slug.
  //   5. Toggle empty vs. saved state: hide #empty-state and show #list-header
  //      (the "Saved bookmarks" heading + "Clear all" button) once at least one
  //      bookmark exists; reverse it when the list is empty.
  //   6. Wire the #clear-all button to remove every saved bookmark (clear the
  //      list, clear browser storage) after a quick confirm.
  //   7. On page load, read the saved bookmarks from storage and render
  //      them so the list persists across reloads.
  //
  // Because this code lives in a client <script>
  // CLIENT-SIDE BOUNDARY - runs in the browser only, so localStorage is safe here.
  const STORAGE_KEY = 'bookmarks';
  const SLUG_PREFIX = 'mona-';
  const BASE62 = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  function loadBookmarks() {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      return Array.isArray(parsed)
        ? parsed.filter((b) => b && typeof b.url === 'string' && typeof b.slug === 'string')
        : [];
    } catch {
      return [];
    }
  }

  function saveBookmarks(items) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch {
      // Storage may be unavailable (private mode, quota); keep the in-memory list.
    }
  }

  let bookmarks = loadBookmarks();

  function normalizeUrl(raw) {
    const value = raw.trim();
    if (!value) return null;
    const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(value) ? value : 'https://' + value;
    try {
      const url = new URL(withScheme);
      if (url.protocol !== 'http:' && url.protocol !== 'https:') return null;
      if (!url.hostname.includes('.') && url.hostname !== 'localhost') return null;
      return url.href;
    } catch {
      return null;
    }
  }

  function generateSlug() {
    const used = new Set(bookmarks.map((b) => b.slug));
    let slug;
    do {
      let id = '';
      for (let i = 0; i < 4; i++) id += BASE62[Math.floor(Math.random() * BASE62.length)];
      slug = SLUG_PREFIX + id;
    } while (used.has(slug));
    return slug;
  }

  function render() {
    list.replaceChildren(
      ...bookmarks.map((bookmark) => {
        const item = document.createElement('li');
        item.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.textContent = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'copy';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', 'Copy slug ' + bookmark.slug);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            copy.textContent = 'Copied!';
          } catch {
            copy.textContent = 'Copy failed';
          }
          setTimeout(() => (copy.textContent = 'Copy'), 1500);
        });

        item.append(link, slug, copy);
        return item;
      })
    );

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this - stops the page from reloading
    const url = normalizeUrl(input.value);
    if (!url) {
      input.setCustomValidity('Please enter a valid http(s) URL.');
      input.reportValidity();
      return;
    }
    input.setCustomValidity('');
    bookmarks = [{ url, slug: generateSlug() }, ...bookmarks];
    saveBookmarks(bookmarks);
    render();
    form.reset();
    input.focus();
  });

  input.addEventListener('input', () => input.setCustomValidity(''));

  clearAll.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // ignore storage errors
    }
    render();
  });

  render();
</script>
